{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job Market Rejection",
  "type": "object",
  "required": ["id", "company", "position", "application_date", "rejection"],
  "properties": {
    "id": {"type": "string"},
    "company": {"type": "string"},
    "position": {"type": "string"},
    "application_date": {"type": "string", "format": "date"},
    "rejection": {
      "type": "object",
      "required": ["date", "subject", "text"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "time": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
        "subject": {"type": "string"},
        "text": {"type": "string"}
      }
    }
  }
}
